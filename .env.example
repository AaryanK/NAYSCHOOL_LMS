APP_NAME="NaySchool 3.0"
APP_ENV=development
APP_DEBUG=true
# SQLite local:
DATABASE_URL=sqlite:///./nayschool.db
# PostgreSQL production/dev Docker:
# DATABASE_URL=postgresql+psycopg://nayschool:nayschool@localhost:5432/nayschool
SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DEFAULT_AI_PROVIDER=auto
ALLOW_CLOUD_AI=true

OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Embedding and Semantic Search Settings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_TOP_K=5
KEYWORD_TOP_K=5
HYBRID_SEARCH_TOP_K=5
AUTO_EMBED_ON_UPLOAD=true

# Token encryption key for LMS authentication secrets
# For production, generate a real 32-byte Fernet key (e.g. using cryptography.fernet.Fernet.generate_key().decode())
TOKEN_ENCRYPTION_KEY=

# LMS Integration Enablement
LMS_INTEGRATIONS_ENABLED=true

# Blackboard API Configuration
BLACKBOARD_ENABLED=false
BLACKBOARD_BASE_URL=
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=
BLACKBOARD_APP_ID=
BLACKBOARD_REDIRECT_URI=http://127.0.0.1:8000/api/lms/blackboard/oauth/callback
BLACKBOARD_SCOPES=read

# Canvas API Configuration
CANVAS_ENABLED=false
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://127.0.0.1:8000/api/lms/canvas/oauth/callback


