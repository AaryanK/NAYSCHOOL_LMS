APP_NAME="NaySchool 3.0"
APP_ENV=development
APP_DEBUG=true
# SQLite local:
DATABASE_URL=sqlite:///./nayschool.db
# PostgreSQL production/dev Docker:
# DATABASE_URL=postgresql+psycopg://nayschool:nayschool@localhost:5432/nayschool
SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DEFAULT_AI_PROVIDER=auto
ALLOW_CLOUD_AI=true

OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Embedding and Semantic Search Settings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_TOP_K=5
KEYWORD_TOP_K=5
HYBRID_SEARCH_TOP_K=5
AUTO_EMBED_ON_UPLOAD=true

# Required outside local development. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LMS Integration Enablement
LMS_INTEGRATIONS_ENABLED=true

# Blackboard API Configuration
BLACKBOARD_ENABLED=false
# Deprecated compatibility value. Each student enters their institution's Blackboard origin when connecting.
BLACKBOARD_BASE_URL=
# OAuth Key from the Anthology Developer Portal. This is the OAuth client_id, NOT the Application ID.
BLACKBOARD_CLIENT_ID=
# OAuth Secret paired with the OAuth Key. Never expose this to frontend JavaScript.
BLACKBOARD_CLIENT_SECRET=
# Application ID installed/approved by each institution's Blackboard administrator. Not sent as client_id.
BLACKBOARD_APP_ID=
# Must exactly match the callback registered in the Anthology Developer Portal.
BLACKBOARD_REDIRECT_URI=http://127.0.0.1:8000/api/lms/blackboard/oauth/callback
# Read-only student access plus refresh-token capability. Do not add write/delete for this integration.
BLACKBOARD_SCOPES="read offline"
BLACKBOARD_OAUTH_STATE_TTL_MINUTES=10
BLACKBOARD_HTTP_TIMEOUT_SECONDS=15

# Canvas API Configuration
CANVAS_ENABLED=false
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://127.0.0.1:8000/api/lms/canvas/oauth/callback

